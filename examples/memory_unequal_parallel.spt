// Different-length SRAM streams share one PX8 pointer and are interleaved.
clock 50 MHz
const BIT = 64 cycles
pin tx0: out = sender0.out
pin tx1: out = sender1.out
pin unused0: in
pin unused1: in
flag start0 = 0
timer bit0 { every: BIT, first: BIT, pulse, run: sender0.busy until sender0.done }
timer bit1 { every: BIT, first: BIT, pulse, run: sender1.busy until sender1.done }
shifter sender0 { frame: [0, data(8), 1], idle: 1, start: start0, shift: bit0.tick }
shifter sender1 { frame: [0, data(8), 1], idle: 1, shift: bit1.tick }
export fn send_left_long() {
    parallel {
        sender0.send([0x10, 0x11, 0x12, 0x13, 0x14])
        sender1.send([0x20])
    }
}
export fn send_right_long() {
    parallel {
        sender0.send([0x30])
        sender1.send([0x40, 0x41, 0x42, 0x43])
    }
}
test "unequal streams in both directions" {
    attach uart_device(from_chip: tx0, to_chip: unused0, bit: BIT) as left
    attach uart_device(from_chip: tx1, to_chip: unused1, bit: BIT) as right
    send_left_long()
    expect left.read(5) == [0x10, 0x11, 0x12, 0x13, 0x14]
    expect right.read(1) == [0x20]
    send_right_long()
    expect left.read(1) == [0x30]
    expect right.read(4) == [0x40, 0x41, 0x42, 0x43]
}
