// UART, 8N1, full duplex: one start bit (0), eight data bits LSB first, one stop bit (1).

clock 50 MHz
const BIT = 64 cycles   // 781 250 baud

pin tx: out = sender.out
pin rx: in

// Transmit. The bit clock runs only while a frame is on the wire; times are
// at the pins (each bit lasts BIT at tx), the compiler removes path latency.
timer tx_bit { every: BIT, first: BIT, pulse, run: sender.busy until sender.done }
shifter sender {
    frame: [0, data(8), 1],
    idle: 1,
    shift: tx_bit.tick,
}

// Receive. A falling edge (the start bit) starts the bit clock, which then
// samples the middle of every bit: BIT / 2 after the edge, at the rx pin.
timer rx_bit { every: BIT, first: BIT / 2, pulse, run: rx.fall until receiver.done }
shifter receiver {
    frame: [0, data(8), 1],
    start: rx.fall,
    shift: rx_bit.tick,
    sample: rx at rx_bit.tick,
}

export stream send: host -> sender
export stream recv: receiver -> host

// ─── tests ───────────────────────────────────────────────

test "loopback" {
    wire tx -> rx
    send.write([0x55, 0xA3, 0x00])
    expect recv.read(3) == [0x55, 0xA3, 0x00]
}

test "talks to a terminal" {
    attach uart_device(from_chip: tx, to_chip: rx, bit: BIT) as terminal
    send.write("hi")
    expect terminal.read(2) == "hi"
    terminal.write("ok")
    expect recv.read(2) == "ok"
}
