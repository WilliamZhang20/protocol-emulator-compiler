; Continuous 8-N-1 UART TX — same shape as
; protocol-emulator test/cocotb_tests/reference/programs.py:uart_tx_program
;
; gpio_oe / gpio_write / tx_load / shift_out / wait16 / jmp / halt
; match docs/architecture.md encodings. TX_LOAD stalls on an empty FIFO.

gpio_oe 0, 1
gpio_write 0, 1
loop:
  tx_load
  gpio_write 0, 0
  wait16 423
  shift_out 0
  wait16 423
  shift_out 0
  wait16 423
  shift_out 0
  wait16 423
  shift_out 0
  wait16 423
  shift_out 0
  wait16 423
  shift_out 0
  wait16 423
  shift_out 0
  wait16 423
  shift_out 0
  wait16 423
  gpio_write 0, 1
  wait16 423
  jmp loop
