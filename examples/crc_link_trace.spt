// Short, complete stored-frame trace for the registered shifter/CRC link.
clock 40 MHz
const FRAME = [0x55, 0x55, 0x55, 0x55, 0x55, 0x55, 0x55, 0xD5,
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x02, 0x12, 0x34, 0x56,
    0x78, 0x9A, 0x08, 0x00, 0x00, 0x01, 0x02, 0x03, 0x04, 0x05,
    0x06, 0x07, 0x08, 0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F,
    0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18, 0x19,
    0x1A, 0x1B, 0x1C, 0x1D, 0x1E, 0x1F, 0x20, 0x21, 0x22, 0x23,
    0x24, 0x25, 0x26, 0x27, 0x28, 0x29, 0x2A, 0x2B, 0x2C, 0x2D]

event begin_frame
flag sending = 0, no_end = 0
pin tx: out = bits.out
timer half_bit { every: 2 cycles, pulse, run: 1 }
shifter bits {
    shift: half_bit.tick,
    start: half_bit.tick,
    burst,
    end: no_end,
    end_on_packet,
    manchester,
    crc_tail_bits: 32,
    crc_skip_bits: 64,
}
crc fcs {
    width: 32,
    poly: 0x04C11DB7,
    check: 0xC704DD7B,
    link: bits,
    restart: begin_frame,
}

export fn transmit() {
    clear_flags()
    fire begin_frame
    set_flags(sending)
    bits.send(FRAME)
    wait bits.done
}

test "profile direct CRC events on a complete Ethernet frame" {
    transmit()
}
