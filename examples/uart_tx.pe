// UART TX sketch in the frontend language.
// Same programming model as protocol-emulator uart_tx_program:
// GPIO + WAIT16 bit-bang, TX FIFO, SHIFT_OUT. No dedicated UART FSM.
//
// pec dumps AST/IR only. Assemble the sibling uart_tx.peas for SRAM bytes.

engine uart_tx {
  pin tx = 0;
  imm bit_wait = 423;

  gpio_oe(tx, 1);
  gpio_write(tx, 1);

  loop {
    tx_load;
    gpio_write(tx, 0);
    wait16(bit_wait);
    repeat (8) {
      shift_out(tx);
      wait16(bit_wait);
    }
    gpio_write(tx, 1);
    wait16(bit_wait);
  }
}
