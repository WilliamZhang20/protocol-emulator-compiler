// Dual-channel UART throughput probe: interleaved host writes keep both TX FIFOs fed.
clock 50 MHz
const BIT = 64 cycles

pin tx_a: out = sender_a.out
pin tx_b: out = sender_b.out
pin rx_a: in
pin rx_b: in
timer bit_a { every: BIT, first: BIT - 2 cycles, pulse, run: sender_a.busy until sender_a.done }
timer bit_b { every: BIT, first: BIT - 2 cycles, pulse, run: sender_b.busy until sender_b.done }
shifter sender_a { frame: [0, data(8), 1], idle: 1, shift: bit_a.tick }
shifter sender_b { frame: [0, data(8), 1], idle: 1, shift: bit_b.tick }
export stream send_a: host -> sender_a
export stream send_b: host -> sender_b

test "interleaved dual-channel UART throughput" {
    attach uart_device(from_chip: tx_a, to_chip: rx_a, bit: BIT) as terminal_a
    attach uart_device(from_chip: tx_b, to_chip: rx_b, bit: BIT) as terminal_b
    send_a.write([0x00])
    send_b.write([0x80])
    send_a.write([0x01])
    send_b.write([0x81])
    send_a.write([0x02])
    send_b.write([0x82])
    send_a.write([0x03])
    send_b.write([0x83])
    send_a.write([0x04])
    send_b.write([0x84])
    send_a.write([0x05])
    send_b.write([0x85])
    send_a.write([0x06])
    send_b.write([0x86])
    send_a.write([0x07])
    send_b.write([0x87])
    send_a.write([0x08])
    send_b.write([0x88])
    send_a.write([0x09])
    send_b.write([0x89])
    send_a.write([0x0a])
    send_b.write([0x8a])
    send_a.write([0x0b])
    send_b.write([0x8b])
    send_a.write([0x0c])
    send_b.write([0x8c])
    send_a.write([0x0d])
    send_b.write([0x8d])
    send_a.write([0x0e])
    send_b.write([0x8e])
    send_a.write([0x0f])
    send_b.write([0x8f])
    send_a.write([0x10])
    send_b.write([0x90])
    send_a.write([0x11])
    send_b.write([0x91])
    send_a.write([0x12])
    send_b.write([0x92])
    send_a.write([0x13])
    send_b.write([0x93])
    send_a.write([0x14])
    send_b.write([0x94])
    send_a.write([0x15])
    send_b.write([0x95])
    send_a.write([0x16])
    send_b.write([0x96])
    send_a.write([0x17])
    send_b.write([0x97])
    send_a.write([0x18])
    send_b.write([0x98])
    send_a.write([0x19])
    send_b.write([0x99])
    send_a.write([0x1a])
    send_b.write([0x9a])
    send_a.write([0x1b])
    send_b.write([0x9b])
    send_a.write([0x1c])
    send_b.write([0x9c])
    send_a.write([0x1d])
    send_b.write([0x9d])
    send_a.write([0x1e])
    send_b.write([0x9e])
    send_a.write([0x1f])
    send_b.write([0x9f])
    expect terminal_a.read(32) == [0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f, 0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f]
    expect terminal_b.read(32) == [0x80, 0x81, 0x82, 0x83, 0x84, 0x85, 0x86, 0x87, 0x88, 0x89, 0x8a, 0x8b, 0x8c, 0x8d, 0x8e, 0x8f, 0x90, 0x91, 0x92, 0x93, 0x94, 0x95, 0x96, 0x97, 0x98, 0x99, 0x9a, 0x9b, 0x9c, 0x9d, 0x9e, 0x9f]
}
test "channel A UART sanity" {
    attach uart_device(from_chip: tx_a, to_chip: rx_a, bit: BIT) as terminal_a
    send_a.write([0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08])
    expect terminal_a.read(8) == [0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08]
}

test "channel B UART sanity" {
    attach uart_device(from_chip: tx_b, to_chip: rx_b, bit: BIT) as terminal_b
    send_b.write([0x80, 0x81, 0x82, 0x83, 0x84, 0x85, 0x86, 0x87])
    expect terminal_b.read(8) == [0x80, 0x81, 0x82, 0x83, 0x84, 0x85, 0x86, 0x87]
}
test "concurrent dual-channel UART sanity" {
    attach uart_device(from_chip: tx_a, to_chip: rx_a, bit: BIT) as terminal_a
    attach uart_device(from_chip: tx_b, to_chip: rx_b, bit: BIT) as terminal_b
    send_a.write([0x20, 0x21, 0x22, 0x23, 0x24, 0x25, 0x26, 0x27])
    send_b.write([0xa0, 0xa1, 0xa2, 0xa3, 0xa4, 0xa5, 0xa6, 0xa7])
    expect terminal_a.read(8) == [0x20, 0x21, 0x22, 0x23, 0x24, 0x25, 0x26, 0x27]
    expect terminal_b.read(8) == [0xa0, 0xa1, 0xa2, 0xa3, 0xa4, 0xa5, 0xa6, 0xa7]
}
test "batched dual-channel UART throughput" {
    attach uart_device(from_chip: tx_a, to_chip: rx_a, bit: BIT) as terminal_a
    attach uart_device(from_chip: tx_b, to_chip: rx_b, bit: BIT) as terminal_b
    send_a.write([0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f, 0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f])
    send_b.write([0x80, 0x81, 0x82, 0x83, 0x84, 0x85, 0x86, 0x87, 0x88, 0x89, 0x8a, 0x8b, 0x8c, 0x8d, 0x8e, 0x8f, 0x90, 0x91, 0x92, 0x93, 0x94, 0x95, 0x96, 0x97, 0x98, 0x99, 0x9a, 0x9b, 0x9c, 0x9d, 0x9e, 0x9f])
    expect terminal_a.read(32) == [0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f, 0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f]
    expect terminal_b.read(32) == [0x80, 0x81, 0x82, 0x83, 0x84, 0x85, 0x86, 0x87, 0x88, 0x89, 0x8a, 0x8b, 0x8c, 0x8d, 0x8e, 0x8f, 0x90, 0x91, 0x92, 0x93, 0x94, 0x95, 0x96, 0x97, 0x98, 0x99, 0x9a, 0x9b, 0x9c, 0x9d, 0x9e, 0x9f]
}
test "single-channel FIFO-boundary UART burst" {
    attach uart_device(from_chip: tx_a, to_chip: rx_a, bit: BIT) as terminal_a
    send_a.write([0x40, 0x41, 0x42, 0x43, 0x44, 0x45, 0x46, 0x47, 0x48, 0x49, 0x4a, 0x4b, 0x4c, 0x4d, 0x4e, 0x4f])
    expect terminal_a.read(16) == [0x40, 0x41, 0x42, 0x43, 0x44, 0x45, 0x46, 0x47, 0x48, 0x49, 0x4a, 0x4b, 0x4c, 0x4d, 0x4e, 0x4f]
}
test "low-value UART burst" {
    attach uart_device(from_chip: tx_a, to_chip: rx_a, bit: BIT) as terminal_a
    send_a.write([0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f])
    expect terminal_a.read(16) == [0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f]
}
