// A clocked level drives a two-state handshake directly in a fabric actor.
timer sample { every: 4 cycles, run: 1 }

protocol handshake on sample.out {
    transition 0 low -> 0
    transition 0 high -> 1 action 1
    transition 1 low -> 0 action 2
    transition 1 high -> 1
}

export fn wait_for_high() {
    wait handshake.action1
}

export fn wait_for_low() {
    wait handshake.action2
}

test "actor takes the high transition" {
    wait_for_high()
}

test "actor takes the low transition" {
    wait_for_low()
}
