// A nine-state protocol is too large for the actors' 4-state/2-input and
// 8-state/1-input modes. The mapper
// lowers its pulse-driven graph to the PX8 controller and fires the shifter.
const BIT = 64 cycles
timer control_tick { every: 16 cycles, pulse, run: 1 }
timer tx_bit { every: BIT, pulse, run: sender.busy until sender.done }

protocol handshake on control_tick.tick {
    transition 0 low -> 0
    transition 0 high -> 1
    transition 1 low -> 1
    transition 1 high -> 2
    transition 2 low -> 2
    transition 2 high -> 3
    transition 3 low -> 3
    transition 3 high -> 4
    transition 4 low -> 4
    transition 4 high -> 5
    transition 5 low -> 5
    transition 5 high -> 6
    transition 6 low -> 6
    transition 6 high -> 7
    transition 7 low -> 7
    transition 7 high -> 8 action 1
    transition 8 low -> 8
    transition 8 high -> 8
}

pin tx: out = sender.out
pin rx: in
shifter sender {
    frame: [0, data(8), 1],
    idle: 1,
    shift: tx_bit.tick,
    start: handshake.action1,
}
export stream send: host -> sender

test "controller backend advances protocol and starts the shifter" {
    attach uart_device(from_chip: tx, to_chip: rx, bit: BIT) as terminal
    send.write([0xA5])
    expect terminal.read(1) == [0xA5]
}
