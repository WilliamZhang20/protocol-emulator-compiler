# UART receive, 8N1, timed entirely by the lane core: the start edge starts
# timer0 and the coded shifter, timer0 ticks sample, the shifter's stop
# stops timer0. The lane only checks and moves bytes. Eight frames per run.
        SETC 8
next:   WAIT event:coder.word       # a frame was sampled (mid stop bit)
        RD readback:coder.status
        AND 0x40                    # word bad: the stop bit was low
        JNZ bad
        RD readback:coder.rx_word
        PUSH
        LOOP next
        HALT
bad:    FAIL
