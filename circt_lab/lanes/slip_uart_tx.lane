# SLIP (RFC 1055) framing on a UART transmitter, 8N1, LSB first.
# END (0xC0) inside the packet is sent as ESC ESC_END (0xDB 0xDC), ESC
# (0xDB) as ESC ESC_ESC (0xDB 0xDD); END closes the packet. The lane
# decides per byte and SHIFTs the byte; the coded shifter adds the start
# and stop bits and timer0 times every bit.
next:   RD readback:stream_bytes_left
        JZ end
        PULL
        ATOC                        # C = byte
        XOR 0xC0
        JZ is_end
        XOR 0x1B                    # byte ^ 0xDB
        JZ is_esc
        CTOA
        SHIFT
        WAIT event:coder.stop
        J next
is_end: LDI 0xDC
        J escape
is_esc: LDI 0xDD
escape: ATOC                        # C = the escaped code
        LDI 0xDB                    # ESC
        SHIFT
        WAIT event:coder.stop
        CTOA
        SHIFT
        WAIT event:coder.stop
        J next
end:    LDI 0xC0                    # END
        SHIFT
        WAIT event:coder.stop
        HALT
