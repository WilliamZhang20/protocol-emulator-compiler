# I2C target, write transactions, 7-bit address 0x48, at most 400 kHz SCL.
# The core's coded shifter samples SDA on each SCL rise and ends its word at
# the eighth. The lane decides: START and STOP, the address match, when to
# pull SDA for ACK (SCL low after the eighth bit until the ninth clock
# falls), and where each byte goes (the stream writer). Actions: 0 pulls
# SDA, 1 aborts the shifter (set while the lane is idle). Transactions to
# other addresses get no ACK and are skipped up to their STOP. The lane
# halts after the first matching transaction's STOP. Lines are waited on
# as levels when high and as latched fall events when low, so each such
# wait is preceded by a CLEAR.
        ACT 0                       # release SDA, shifter running
free:   WAIT level:in1              # SDA high
        WAIT level:in0              # SCL high: the bus is idle
        CLEAR
idle:   WAIT event:in1.fall         # SDA falls ...
        RD readback:inputs
        AND 1
        JZ free                     # ... while SCL is low: not a START
        FIRE                        # START: receive the address byte
        WAIT event:coder.word
        RD readback:coder.rx_word
        XOR 0x90                    # 0x48 << 1 | write
        JNZ skip
ack:    CLEAR
        WAIT event:in0.fall         # SCL low after the eighth bit
        ACT 1                       # pull SDA: ACK
        WAIT level:in0              # ninth clock high
        CLEAR
        WAIT event:in0.fall         # ninth clock low
        ACT 0                       # release SDA
        CLEAR                       # forget SDA edges seen so far
        FIRE                        # receive the next byte
byte:   WANY bit:event:coder.word|bit:event:in1.rise
        AND bit:event:coder.word
        JNZ got
        RD readback:inputs          # SDA rose: with SCL high it is a STOP
        AND 1
        JZ byte                     # SCL low: an ordinary data change
        HALT                        # STOP: transfer complete
got:    RD readback:coder.rx_word
        PUSH                        # the stream writer stores it
        J ack
skip:   CLEAR                       # not addressed: wait for this STOP
stop:   WAIT event:in1.rise
        RD readback:inputs
        AND 1
        JZ stop
        J free
