// UART transmitter, 8N1, written from the specification: every bit,
// the start bit included, lasts BIT at the tx pin. The compiler takes off
// the chip's start-to-shift latency (pin-referenced timing).
clock 50 MHz
const BIT = 64 cycles

pin tx: out = sender.out

timer bit { every: BIT, first: BIT, pulse, run: sender.busy until sender.done }
shifter sender { frame: [0, data(8), 1], idle: 1, shift: bit.tick }

export stream send: host -> sender
